<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      The webhook is the fast path; this is the one that cannot be blocked
      by a firewall, a laptop, or a callback that simply failed. It asks
      Chapa about every transaction still unconfirmed a couple of minutes
      after it was opened, and settles the ones that were paid.
    -->
    <record id="cron_chapa_verify_pending" model="ir.cron">
        <field name="name">Chapa: verify unconfirmed transactions</field>
        <field name="model_id" ref="payment.model_payment_transaction"/>
        <field name="state">code</field>
        <field name="code">model._cron_chapa_verify_pending()</field>
        <field name="interval_number">3</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
