<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      One form, two shapes, chosen by `checkout_mode` from the rendering
      values.

      html: Chapa's documented HTML Checkout. The browser POSTs the order
      to https://api.chapa.co/v1/hosted/pay with the PUBLIC key; the server
      makes no outbound call until verification. Every field is a hidden
      input, exactly as their integration guide shows.

      api: Odoo has already opened the session with the secret key and holds
      the checkout URL; the form is just a redirect to it.

      Odoo's payment form JS submits this form for the member, so no button
      is rendered here in either case.
    -->
    <template id="redirect_form">
        <t t-if="checkout_mode == 'html'">
            <form t-att-action="api_url" method="post">
                <input type="hidden" name="public_key" t-att-value="public_key"/>
                <input type="hidden" name="tx_ref" t-att-value="tx_ref"/>
                <input type="hidden" name="amount" t-att-value="amount"/>
                <input type="hidden" name="currency" t-att-value="currency"/>
                <input type="hidden" name="email" t-att-value="email"/>
                <input type="hidden" name="first_name" t-att-value="first_name"/>
                <input type="hidden" name="last_name" t-att-value="last_name"/>
                <input t-if="phone_number" type="hidden" name="phone_number" t-att-value="phone_number"/>
                <input type="hidden" name="title" t-att-value="title"/>
                <input type="hidden" name="description" t-att-value="description"/>
                <input type="hidden" name="callback_url" t-att-value="callback_url"/>
                <input type="hidden" name="return_url" t-att-value="return_url"/>
            </form>
        </t>
        <t t-else="">
            <form t-att-action="api_url" method="get"/>
        </t>
    </template>

    <!--
      The direct-charge form, rendered inside Odoo's payment form when the
      provider is in direct mode. The member picks a wallet and types the
      phone number; everything after "Pay" is the JS in
      static/src/interactions/payment_form.js talking to /payment/chapa/*.
    -->
    <template id="inline_form">
        <t t-set="chapa_methods" t-value="provider_sudo._chapa_direct_methods()"/>
        <t t-set="chapa_partner" t-value="request.env['res.partner'].sudo().browse(partner_id) if partner_id else None"/>
        <div t-attf-id="o_chapa_direct_{{provider_id}}" class="o_chapa_direct" t-att-data-provider-id="provider_id">
            <div class="row g-2">
                <div class="col-12 col-sm-5">
                    <label class="form-label small mb-1" t-attf-for="o_chapa_method_{{provider_id}}">Pay with</label>
                    <select t-attf-id="o_chapa_method_{{provider_id}}" name="chapa_method" class="form-select">
                        <t t-foreach="chapa_methods" t-as="method">
                            <option t-att-value="method[0]" t-out="method[1]"/>
                        </t>
                    </select>
                </div>
                <div class="col-12 col-sm-7">
                    <label class="form-label small mb-1" t-attf-for="o_chapa_mobile_{{provider_id}}">Phone number</label>
                    <input t-attf-id="o_chapa_mobile_{{provider_id}}" name="chapa_mobile" type="tel" class="form-control"
                           inputmode="numeric" autocomplete="tel" placeholder="09xx xxx xxx"
                           t-att-value="(chapa_partner and chapa_partner.phone) or ''"/>
                </div>
            </div>
            <p class="small text-muted mt-2 mb-0" name="chapa_hint">
                You'll get a prompt on this phone to approve the payment. Nothing leaves this page.
            </p>
            <p t-if="provider_sudo.state == 'test'" class="small text-warning mb-0">
                Test mode: only 0900123456, 0900112233, 0900881111 (M-Pesa: 0700…) succeed; one-time code 12345.
            </p>
            <!-- After "Pay": what is happening, and the one-time code when a wallet asks for one. -->
            <div name="chapa_status" class="alert alert-info mt-3 mb-0 d-none" role="status"/>
            <div name="chapa_otp" class="mt-3 d-none">
                <label class="form-label small mb-1" t-attf-for="o_chapa_otp_{{provider_id}}">One-time code</label>
                <div class="input-group">
                    <input t-attf-id="o_chapa_otp_{{provider_id}}" name="chapa_otp" type="text" class="form-control"
                           inputmode="numeric" autocomplete="one-time-code" maxlength="8"/>
                    <button type="button" name="chapa_otp_submit" class="btn btn-primary">Confirm code</button>
                </div>
            </div>
        </div>
    </template>
</odoo>
